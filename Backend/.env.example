# =========================
# Database (PostgreSQL)
# =========================
# Prisma uses the pooled runtime URL; CLI/migrations use DIRECT_URL.
DATABASE_URL=postgresql://postgres:my_local_password@localhost:15432/online_auction_test?schema=public
DIRECT_URL=postgresql://postgres:my_local_password@localhost:15432/online_auction_test?schema=public
# Production Configuration (e.g. Supabase, Neon)
# DATABASE_URL=postgresql://...pooler...?pgbouncer=true&schema=public
# DIRECT_URL=postgresql://...direct-host.../postgres?schema=public

# =========================
# Redis
# =========================
# Local API: redis://localhost:16379
# Production processes use the private Docker hostname: redis://:password@redis:6379
REDIS_URL=redis://localhost:16379
AUTH_REDIS_URL=redis://localhost:16379
AUCTION_REDIS_URL=redis://localhost:16379
REDIS_PASSWORD=replace_with_a_long_random_password
BID_ENGINE=redis
BID_DURABILITY_REPLICAS=1
BID_DURABILITY_WAIT_MS=100
BID_MUTATION_CONNECTIONS=8
AUTH_SNAPSHOT_TTL_SECONDS=30
# Per-process principal cache; Pub/Sub invalidates immediately and this TTL is the fallback bound.
AUTH_SNAPSHOT_LOCAL_TTL_MS=2000
BID_PROJECTOR_GROUP=postgres-projector-v1
BID_PROJECTOR_READ_COUNT=200
BID_PROJECTOR_CONCURRENCY=8
BID_PROJECTOR_MAX_ATTEMPTS=10
BID_PROJECTOR_RECLAIM_INTERVAL_MS=30000
AUCTION_CLOSE_INTERVAL_MS=1000
AUCTION_WORKER_HEARTBEAT_TTL_SECONDS=90

# =========================
# Kafka
# =========================
KAFKA_BROKERS=localhost:19094
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=
# Optional PEM CA for managed Kafka endpoints; escaped \n is accepted.
KAFKA_CA=
KAFKA_CLIENT_ID=auction-platform
KAFKA_BIDDING_TOPIC=bidding_events
KAFKA_DOMAIN_TOPIC=domain_events
KAFKA_DASHBOARD_TOPIC=dashboard_updates
KAFKA_ASYNC_DLQ_TOPIC=async_events_dlq
KAFKA_DASHBOARD_DLQ_TOPIC=dashboard_updates_dlq
DASHBOARD_KAFKA_GROUP_ID=dashboard-analytics-v1
NOTIFICATION_KAFKA_GROUP_ID=notification-intake-v1
DASHBOARD_DEBOUNCE_MS=15000
DASHBOARD_BATCH_CONCURRENCY=8
NOTIFICATION_BATCH_CONCURRENCY=8
DASHBOARD_RECOVERY_INTERVAL_MS=60000
DASHBOARD_STALE_THRESHOLD_MS=120000
DASHBOARD_RETRY_LIMIT=5
OUTBOX_BATCH_SIZE=100
OUTBOX_IDLE_POLL_MS=500
OUTBOX_MAX_BACKOFF_MS=300000
OUTBOX_RELAY_HEARTBEAT_TTL_SECONDS=90
ASYNC_WORKER_HEARTBEAT_TTL_SECONDS=90

# =========================
# RabbitMQ
# =========================
# Local: amqp://localhost:5672
# Production: amqps://user:password@host/vhost
RABBITMQ_URL=amqp://localhost:5672

# =========================
# Gmail (SMTP)
# =========================
GMAIL_ADDRESS=your_gmail_address
GMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_DELIVERY_MODE=disabled
EMAIL_DELIVERY_CONCURRENCY=2
EMAIL_DELIVERY_MAX_ATTEMPTS=5
EMAIL_DELIVERY_LEASE_MS=300000

# =========================
# Cloudinary
# =========================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =========================
# JWT
# =========================
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
CSRF_SECRET=use_a_long_random_secret_distinct_from_jwt_secrets

# =========================
# CAPTCHA
# =========================
CAPTCHA_SECRET_KEY=your_captcha_secret_key

# =========================
# Google OAuth (backend-only client ID used to verify ID tokens)
# =========================
GOOGLE_CLIENT_ID=your_google_client_id

# =========================
# Client
# =========================
CLIENT_URL=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info
PORT=5000
API_DOMAIN=api.example.com

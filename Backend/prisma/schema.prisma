generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model auction_authority_recovery {
  id                    Int       @id
  generation            String    @db.Uuid
  recovery_epoch        BigInt    @default(0)
  state                 String    @default("READY") @db.VarChar(32)
  owner_id               String?   @db.VarChar(160)
  lease_until            DateTime? @db.Timestamptz(6)
  last_redis_healthy_at  DateTime  @default(now()) @db.Timestamptz(6)
  recovery_started_at    DateTime? @db.Timestamptz(6)
  recovery_completed_at  DateTime? @db.Timestamptz(6)
  last_error             String?
  updated_at             DateTime  @default(now()) @db.Timestamptz(6)
}

model auction_authority_recovery_runs {
  run_id               String    @id @db.Uuid
  recovery_epoch       BigInt    @unique
  trigger              String    @db.VarChar(32)
  status               String    @db.VarChar(32)
  source               String    @default("POSTGRESQL") @db.VarChar(32)
  started_at           DateTime  @default(now()) @db.Timestamptz(6)
  completed_at         DateTime? @db.Timestamptz(6)
  recovered_auctions   Int       @default(0)
  extension_seconds    Int       @default(0)
  error                String?
  metadata             Json      @default("{}")
}

model bidding_ban_user {
  id         BigInt    @id @default(autoincrement())
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  product_id BigInt?
  user_id    Int?
  reason     String?
  products   products? @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([product_id, user_id], map: "bidding_ban_user_product_user_unique")
}

model bidding_history {
  bidding_id     BigInt   @id @default(autoincrement())
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  product_id     BigInt
  user_id        Int
  max_price      BigInt?
  product_price  BigInt?
  price_owner_id BigInt?
  status         String?
  event_id       String?  @unique @db.Uuid
  sequence       BigInt?
  version        BigInt?
  products       products @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)
  users          users    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([product_id, sequence], map: "bidding_history_product_sequence_unique")
}

model categories {
  id               Int          @id @default(autoincrement())
  name             String       @db.VarChar(50)
  parent_id        Int?
  status           String       @default("active") @db.VarChar(10)
  deleted          Boolean      @default(false)
  description      String?      @db.VarChar(1000)
  created_by       Int?
  updated_by       Int?
  created_at       DateTime     @default(now()) @db.Timestamp(6)
  updated_at       DateTime     @default(now()) @db.Timestamp(6)
  slug             String?      @unique @db.VarChar(100)
  cat_image        String?
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_categories_parent")
  other_categories categories[] @relation("categoriesTocategories")
}

model dashboard_stats {
  key                 String    @id @db.VarChar(50)
  value               Json
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
  version             BigInt    @default(0)
  refresh_duration_ms Int?
  source_event_count  Int       @default(0)
  reason              String?   @db.VarChar(100)
}

model extend_bidding_time {
  id             BigInt   @id(map: "extendbiddingtime_pkey") @default(autoincrement())
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  extend_time    BigInt?  @default(10)
  threshold_time BigInt?  @default(5)
}

model love_products {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user_id    Int
  product_id BigInt
  products   products @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model orders {
  order_id                 BigInt    @id @default(autoincrement())
  public_order_id          String    @unique @default(uuid()) @db.Uuid
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  user_id                  Int
  product_id               BigInt?
  auction_sequence         BigInt?
  order_status             String?   @default("pending")
  rejection_reason         String?   @db.VarChar(500)
  shipping_address         String?
  phone_number             String?
  payment_proof_image_url  String?
  shipping_label_image_url String?
  amount_vnd               BigInt?
  completed_at             DateTime? @db.Timestamptz(6)
  products                 products? @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)
  users                    users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([product_id], map: "orders_one_per_product_unique")
}

model otp_codes {
  id         Int       @id @default(autoincrement())
  email      String    @unique @db.VarChar(255)
  otp        String    @db.VarChar(10)
  otp_expiry DateTime? @default(dbgenerated("(now() + '00:02:00'::interval)")) @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model product_questions {
  question_id             BigInt              @id @default(autoincrement())
  created_at              DateTime            @default(now()) @db.Timestamptz(6)
  product_id              BigInt
  user_id                 Int
  content                 String?
  question_parent_id      BigInt?
  products                products            @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)
  product_questions       product_questions?  @relation("product_questionsToproduct_questions", fields: [question_parent_id], references: [question_id], onDelete: NoAction, onUpdate: NoAction)
  other_product_questions product_questions[] @relation("product_questionsToproduct_questions")
  users                   users               @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model products {
  product_id             BigInt                   @id @default(autoincrement())
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  product_name           String?                  @db.VarChar
  seller_id              BigInt
  step_price             BigInt?
  start_price            BigInt?
  current_price          BigInt?
  buy_now_price          BigInt?
  price_owner_id         BigInt?
  bid_turns              BigInt?                  @default(0)
  start_time             DateTime?                @db.Timestamptz(6)
  end_time               DateTime?                @db.Timestamptz(6)
  cat2_id                BigInt?
  is_removed             Boolean?                 @default(false)
  description            String?
  product_images         String[]                 @db.VarChar
  auto_extended          Boolean?                 @default(false)
  edited_at              DateTime?                @db.Timestamptz(6)
  fts                    Unsupported("tsvector")? @default(dbgenerated("setweight(to_tsvector('simple'::regconfig, remove_accents(COALESCE(product_name, ''::character varying)::text)), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, remove_accents(COALESCE(description, ''::text))), 'B'::\"char\")"))
  auction_end_email_sent Boolean?                 @default(false)
  auction_notification_enqueued_at DateTime?      @db.Timestamptz(6)
  auction_status         String                   @default("PENDING") @db.VarChar(16)
  auction_version        BigInt                   @default(0)
  auction_sequence       BigInt                   @default(0)
  last_authority_recovery_epoch BigInt            @default(0)
  bidding_ban_user       bidding_ban_user[]
  bidding_history        bidding_history[]
  love_products          love_products[]
  orders                 orders[]
  product_questions      product_questions[]
  // Kept scalar because PostgreSQL permits the legacy bigint -> integer FK,
  // while Prisma requires both sides of a relation to use the same type.

  @@index([fts], map: "products_fts", type: Gin)
}

model bid_idempotency {
  id                  BigInt   @id @default(autoincrement())
  operation           String   @db.VarChar(40)
  user_id             Int
  idempotency_key     String   @db.VarChar(255)
  request_fingerprint String   @db.VarChar(128)
  response_body       Json
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  users               users    @relation(fields: [user_id], references: [user_id])

  @@unique([operation, user_id, idempotency_key], map: "bid_idempotency_operation_user_key_unique")
}

model auction_outbox {
  id            BigInt    @id @default(autoincrement())
  event_id      String    @unique @default(uuid()) @db.Uuid
  event_type    String    @db.VarChar(100)
  event_version Int
  aggregate_id  String    @db.VarChar(64)
  payload       Json
  attempts      Int       @default(0)
  available_at  DateTime  @default(now()) @db.Timestamptz(6)
  delivered_at  DateTime? @db.Timestamptz(6)
  last_error    String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  topic         String    @default("bidding_events") @db.VarChar(100)
  correlation_id String   @default(uuid()) @db.Uuid
  causation_id  String?   @db.Uuid
  occurred_at   DateTime  @default(now()) @db.Timestamptz(6)
  terminal_at   DateTime? @db.Timestamptz(6)

  @@index([delivered_at, available_at, id], map: "auction_outbox_pending_idx")
  @@index([terminal_at, delivered_at, available_at, id], map: "auction_outbox_relay_pending_idx")
}

model notification_event_receipts {
  event_id       String    @id @db.Uuid
  topic          String    @db.VarChar(100)
  event_type     String    @db.VarChar(100)
  event_version  Int
  aggregate_id   String    @db.VarChar(64)
  correlation_id String    @db.Uuid
  payload        Json
  status         String    @db.VarChar(20)
  attempts       Int       @default(0)
  last_error     String?
  partition      Int?
  offset         String?   @db.VarChar(32)
  processed_at   DateTime? @db.Timestamptz(6)
  terminal_at    DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, updated_at], map: "notification_event_receipts_status_idx")
}

model email_deliveries {
  id              BigInt    @id @default(autoincrement())
  source_event_id String    @db.Uuid
  recipient_key   String    @db.VarChar(160)
  recipient_email String    @db.VarChar(320)
  template_key    String    @db.VarChar(100)
  subject         String    @db.VarChar(500)
  html_body       String
  text_body       String
  message_id      String    @db.VarChar(255)
  status          String    @default("pending") @db.VarChar(20)
  attempts        Int       @default(0)
  available_at    DateTime  @default(now()) @db.Timestamptz(6)
  lease_until     DateTime? @db.Timestamptz(6)
  last_error      String?
  sent_at         DateTime? @db.Timestamptz(6)
  terminal_at     DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([source_event_id, recipient_key, template_key], map: "email_deliveries_event_recipient_template_unique")
  @@unique([message_id], map: "email_deliveries_message_id_unique")
  @@index([status, available_at, lease_until, id], map: "email_deliveries_pending_idx")
}

model dashboard_event_receipts {
  event_id       String    @id @db.Uuid
  topic          String    @db.VarChar(100)
  event_type     String    @db.VarChar(100)
  event_version  Int
  aggregate_id   String    @db.VarChar(64)
  correlation_id String    @db.Uuid
  payload        Json
  status         String    @db.VarChar(20)
  attempts       Int       @default(0)
  last_error     String?
  partition      Int?
  offset         String?   @db.VarChar(32)
  processed_at   DateTime? @db.Timestamptz(6)
  terminal_at    DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, updated_at], map: "dashboard_event_receipts_status_idx")
}

model admin_audit_logs {
  id             BigInt   @id @default(autoincrement())
  actor_id       Int?
  action         String   @db.VarChar(100)
  resource_type  String   @db.VarChar(100)
  resource_id    String?  @db.VarChar(100)
  result         String   @db.VarChar(20)
  error_code     String?  @db.VarChar(100)
  correlation_id String   @db.Uuid
  metadata       Json?
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at, id], map: "admin_audit_logs_created_idx")
  @@index([actor_id, action, result], map: "admin_audit_logs_filter_idx")
}

model auction_processed_events {
  event_id       String   @id @db.Uuid
  redis_entry_id String   @unique @db.VarChar(80)
  product_id     BigInt
  sequence       BigInt
  version        BigInt
  processed_at   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([product_id, sequence], map: "auction_processed_product_sequence_unique")
}

model auction_transitions {
  id         BigInt   @id @default(autoincrement())
  event_id   String   @unique @db.Uuid
  product_id BigInt
  event_type String   @db.VarChar(64)
  sequence   BigInt
  version    BigInt
  payload    Json
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([product_id, sequence], map: "auction_transition_product_sequence_unique")
  @@index([product_id, version], map: "auction_transition_product_version_idx")
}

model upgrade_to_sellers {
  id          BigInt    @id @default(autoincrement())
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  user_id     Int
  expiry_time DateTime? @db.Timestamptz(6)
  reason      String?
  status      String?   @default("pending")
  users       users     @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model user_blacklist {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user_id    Int
  users      users    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model user_rating {
  id                                BigInt   @id @default(autoincrement())
  created_at                        DateTime @default(now()) @db.Timestamptz(6)
  user_id                           Int
  rater_id                          Int
  score                             BigInt
  comment                           String?
  users_user_rating_rater_idTousers users    @relation("user_rating_rater_idTousers", fields: [rater_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_user_rating_user_idTousers  users    @relation("user_rating_user_idTousers", fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  user_id                                 Int                      @id @default(autoincrement())
  username                                String                   @db.VarChar(50)
  full_name                               String                   @db.VarChar(50)
  email                                   String                   @unique @db.VarChar(50)
  password                                String?                  @db.VarChar(100)
  address                                 String?                  @db.VarChar(100)
  role                                    String?                  @default("user") @db.VarChar(10)
  date_of_birth                           DateTime?                @db.Date
  rating                                  Float?                   @default(0.0)
  rating_count                            Int?                     @default(0)
  created_at                              DateTime?                @default(now()) @db.Timestamptz(6)
  avatar                                  String?
  status                                  String                   @default("active")
  auth_version                            Int                      @default(0)
  fts                                     Unsupported("tsvector")? @default(dbgenerated("to_tsvector('english'::regconfig, ((remove_accents((COALESCE(full_name, ''::character varying))::text) || ' '::text) || remove_accents((COALESCE(email, ''::character varying))::text)))"))
  bidding_ban_user                        bidding_ban_user[]
  bidding_history                         bidding_history[]
  bid_idempotency                         bid_idempotency[]
  love_products                           love_products[]
  orders                                  orders[]
  product_questions                       product_questions[]
  upgrade_to_sellers                      upgrade_to_sellers[]
  user_blacklist                          user_blacklist[]
  user_rating_user_rating_rater_idTousers user_rating[]            @relation("user_rating_rater_idTousers")
  user_rating_user_rating_user_idTousers  user_rating[]            @relation("user_rating_user_idTousers")

  @@index([fts], map: "users_fts", type: Gin)
}
